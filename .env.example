# Plantilla de variables de entorno. Copiar a .env y rellenar con valores reales.
# .env está en .gitignore: NUNCA se commitea. Aquí no van credenciales reales.

# Token de la private app de HubSpot (en producción, la del cliente)
HUBSPOT_ACCESS_TOKEN=

# Cloudflare R2
URL_PUBLIC_dEV=https://<tu-bucket-publico>.r2.dev
ACCOUNT_ID=<cloudflare-account-id>
S3_API=https://<account-id>.r2.cloudflarestorage.com
BUCKET_NAME=<nombre-del-bucket>
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
